# Copier en .env et remplir. Ne jamais committer .env dans git.

# --- PostgreSQL ---
# voxpme_app est ici l'utilisateur d'init du conteneur : il devient
# automatiquement propriétaire de la base "voxpme", cohérent avec l'état
# réel sur la VM (voxpme_app possède déjà la majorité des tables).
POSTGRES_DB=voxpme
POSTGRES_USER=voxpme_app
POSTGRES_PASSWORD=

# --- Même mot de passe que POSTGRES_PASSWORD, mais URL-encodé (le "#" doit
#     devenir "%23") : nécessaire dans toute chaîne de connexion de type URL
#     (DATABASE_URL du backend, VOXPME_DB_DSN d'Asterisk). Postgres lui-même
#     utilise POSTGRES_PASSWORD brut, sans encodage.
POSTGRES_PASSWORD_URLENC=Leroi5alomon%23

# --- ODBC / ARA (même compte que POSTGRES_USER ci-dessus — voxpme_app
#     possède déjà la majorité des tables sur la VM actuelle, cf. \dp) ---
# --- ODBC / ARA (même compte que POSTGRES_USER ci-dessus — voxpme_app
#     possède déjà la majorité des tables sur la VM actuelle, cf. \dp) ---
ODBC_DSN=voxpme-db
ODBC_DSN_PASSWORD=

# --- ARI (Asterisk REST Interface) ---
ARI_USER=voxpme-ari
ARI_PASSWORD=

# --- IP de la machine hôte (Asterisk est en network_mode: host,
#     le backend a besoin de cette IP pour joindre ARI sur :8088) ---
HOST_IP=127.0.0.1

# --- Trunk SIP sortant/entrant (Callcentric) ---
CALLCENTRIC_USER=
CALLCENTRIC_PASSWORD=
CALLCENTRIC_HOST=

# --- Grafana ---
GRAFANA_ADMIN_PASSWORD=
